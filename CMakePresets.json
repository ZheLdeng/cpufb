{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Unix Makefiles"
    },
    {
      "name": "native-release",
      "displayName": "Native Release (auto-detect arch)",
      "description": "Build for the host architecture, optimized.",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "inherits": "_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 (MinGW-w64)",
      "description": "Native Windows x64 build using the MinGW-w64 POSIX toolchain.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_ASM_COMPILER": "gcc"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon",
      "description": "Native build on macOS arm64.",
      "inherits": "_base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "aarch64-cross",
      "displayName": "aarch64-linux-gnu cross",
      "description": "Cross-compile for ARM64 Linux (also used for adb push to Android /data/local/tmp).",
      "inherits": "_base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPUFB_ENABLE_ANDROID_DEPLOY": "ON"
      }
    },
    {
      "name": "riscv64-cross",
      "displayName": "riscv64-linux-gnu cross",
      "inherits": "_base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/riscv64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "jobs": 0
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "jobs": 0
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "jobs": 0
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "jobs": 0
    },
    {
      "name": "aarch64-cross",
      "configurePreset": "aarch64-cross",
      "jobs": 0
    },
    {
      "name": "riscv64-cross",
      "configurePreset": "riscv64-cross",
      "jobs": 0
    }
  ]
}
